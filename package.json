{
  "name": "roledex",
  "version": "0.1.0",
  "private": true,
  "overrides": {
    "nanoid": "3.3.18"
  },
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --webpack -p 3100",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --import tsx src/db/migrate.ts",
    "db:seed": "node --import tsx src/db/seed.ts",
    "appstore:preflight": "node --env-file-if-exists=.env.local --env-file-if-exists=.env.production.local --import tsx scripts/app-store-preflight.ts",
    "native:smoke": "node --import tsx scripts/native-api-smoke.ts",
    "mobile:dev": "vite --config mobile/vite.config.ts --host 0.0.0.0 --port 4173",
    "mobile:build": "vite build --config mobile/vite.config.ts",
    "mobile:add:ios": "npm run mobile:build && cap add ios",
    "mobile:sync": "npm run mobile:build && cap sync ios",
    "mobile:open": "cap open ios",
    "check": "npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.5.0",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.5.3",
    "@capacitor/share": "8.0.1",
    "@libsql/client": "^0.17.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.8",
    "lucide-react": "^1.28.0",
    "mammoth": "^1.13.0",
    "next": "16.3.8",
    "pdf-parse": "^2.4.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "simple-icons": "^16.28.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.0",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "5.0.4",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "shadcn": "^4.21.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.5",
    "typescript": "^5",
    "vite": "^7.3.6",
    "vitest": "^4.1.12"
  }
}
