# Local SQLite database path, resolved from the project root.
DATABASE_URL=./data/jobswipe.db

# Vercel/Turso: these override DATABASE_URL when both are present.
# TURSO_DATABASE_URL=libsql://your-database.turso.io
# TURSO_AUTH_TOKEN=your-secret-token

# Required in production for the authenticated Vercel Cron refresh route.
# Generate a long random value and configure the same CRON_SECRET in Vercel.
# CRON_SECRET=your-long-random-secret

# The stable Production domain serves the phone UI only when this exact opt-in
# is set. Without it, every Production UI path fails closed with 404.
# JOBSWIPE_PRODUCTION_UI=disabled

# Optional for normal product use. Configure an unguessable value of at least
# 20 characters to unlock hidden source-management and manual-import tools.
# JOBSWIPE_ACCESS_PASSWORD=your-long-random-access-key

# Signing secret for the HttpOnly owner and guest session cookies. Generate at
# least 32 random bytes; rotating it disconnects every browser workspace.
# JOBSWIPE_SESSION_SECRET=your-long-random-session-secret

# Optional separate 32-byte-or-longer signing secret for anonymous visitor
# sessions. When omitted, JOBSWIPE_SESSION_SECRET is used.
# JOBSWIPE_VISITOR_SESSION_SECRET=your-long-random-visitor-session-secret

# Local HTTP auth testing only. Never set this in Vercel Production.
# JOBSWIPE_SESSION_COOKIE_SECURE=disabled

# Optional comma-separated hostnames for testing the dev server from another device.
# JOBSWIPE_DEV_ORIGINS=192.168.1.20
