# Local SQLite database path, resolved from the project root.
DATABASE_URL=./data/jobswipe.db

# Vercel/Turso: these override DATABASE_URL when both are present.
# TURSO_DATABASE_URL=libsql://your-database.turso.io
# TURSO_AUTH_TOKEN=your-secret-token

# Required in production for the authenticated Vercel Cron refresh route.
# Generate a long random value and configure the same CRON_SECRET in Vercel.
# CRON_SECRET=your-long-random-secret

# The stable Production domain serves the phone UI only when this exact opt-in
# is set. Without it, every Production UI path fails closed with 404.
# JOBSWIPE_PRODUCTION_UI=disabled

# Optional for normal product use. Configure an unguessable value of at least
# 20 characters to unlock hidden source-management and manual-import tools.
# JOBSWIPE_ACCESS_PASSWORD=your-long-random-access-key

# Signing secret for the HttpOnly owner and guest session cookies. Generate at
# least 32 random bytes; rotating it disconnects every browser workspace.
# JOBSWIPE_SESSION_SECRET=your-long-random-session-secret

# Optional separate 32-byte-or-longer signing secret for anonymous visitor
# sessions. When omitted, JOBSWIPE_SESSION_SECRET is used.
# JOBSWIPE_VISITOR_SESSION_SECRET=your-long-random-visitor-session-secret

# Native API is fail-closed in production until explicitly enabled. Use a
# separate 32-byte signing secret so native access-token rotation is isolated
# from browser sessions.
# JOBSWIPE_NATIVE_API=disabled
# JOBSWIPE_NATIVE_SESSION_SECRET=your-long-random-native-session-secret

# Optional comma-separated extra origins for API v2 mobile previews. The
# production Capacitor origin (capacitor://localhost) is already allowed.
# JOBSWIPE_MOBILE_ORIGINS=https://mobile-preview.example.com

# Leave unset on Vercel. Enable only behind a trusted reverse proxy that
# replaces, rather than forwards untrusted, client address headers.
# JOBSWIPE_TRUST_PROXY_HEADERS=disabled

# Required together to publish the Apple universal-link association document.
# These must match the signed App Store target exactly.
# APPLE_TEAM_ID=A1B2C3D4E5
# JOBSWIPE_BUNDLE_ID=com.yourcompany.jobswipe
# JOBSWIPE_DISPLAY_NAME=Your Final App Name

# Sign in with Apple remains disabled until every value is configured. Never
# commit the private key; store it only in the deployment secret manager.
# APPLE_SERVICE_ID=com.yourcompany.jobswipe.web
# APPLE_KEY_ID=ABC123DEFG
# APPLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----

# Values compiled into the locally bundled Capacitor client by the archive
# script. The production client must use the permanent HTTPS origin.
# VITE_JOBSWIPE_API_BASE_URL=https://jobswipe.example.com
# VITE_JOBSWIPE_APP_VERSION=1.0.0
# VITE_JOBSWIPE_BUILD_NUMBER=1

# Permanent HTTPS origin used by App Store metadata and release checks.
# JOBSWIPE_PUBLIC_URL=https://jobswipe.example.com

# Monitored App Review contact details (also entered in App Store Connect).
# APP_STORE_REVIEW_EMAIL=review@example.com
# APP_STORE_REVIEW_PHONE=+1-555-555-5555

# Local HTTP auth testing only. Never set this in Vercel Production.
# JOBSWIPE_SESSION_COOKIE_SECURE=disabled

# Optional comma-separated hostnames for testing the dev server from another device.
# JOBSWIPE_DEV_ORIGINS=192.168.1.20
